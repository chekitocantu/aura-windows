<Window x:Class="Aura.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura" Width="1280" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="Assets/aura.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <!-- soft aurora glow behind the logo -->
        <Ellipse Width="260" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0"
                 Opacity="0.35" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#889B7BFF" Offset="0" />
              <GradientStop Color="#003EE6C8" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <DockPanel Margin="16,22,16,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,30">
            <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Aura" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
              <TextBlock x:Name="TagLine" FontSize="11" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </StackPanel>

          <!-- Now playing -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="16">
            <StackPanel>
              <Grid Height="108">
                <Border CornerRadius="15,15,0,0" Opacity="0.55">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#3A2E66" Offset="0" />
                      <GradientStop Color="#0F3B45" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border CornerRadius="15,15,0,0">
                  <Border.Background>
                    <ImageBrush x:Name="NowThumb" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border x:Name="NowState" Style="{StaticResource Badge}">
                  <TextBlock x:Name="NowStateText" FontSize="11" Foreground="White" />
                </Border>
              </Grid>
              <StackPanel Margin="14,12,14,14">
                <TextBlock x:Name="NowLabel" FontSize="11" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="NowTitle" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="PauseButton" Click="Pause_Click" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" FontSize="12" Text="&#xE769;" />
                      <TextBlock x:Name="PauseText" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="StopButton" Click="Stop_Click" Padding="10,7">
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE71A;" />
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel>
            <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" GroupName="nav" Tag="library" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" />
                <TextBlock x:Name="NavLibraryText" Margin="14,0,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavExplore" Style="{StaticResource NavItem}" GroupName="nav" Tag="explore" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" />
                <TextBlock x:Name="NavExploreText" Margin="14,0,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavScreens" Style="{StaticResource NavItem}" GroupName="nav" Tag="screens" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" />
                <TextBlock x:Name="NavScreensText" Margin="14,0,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                <TextBlock x:Name="NavSettingsText" Margin="14,0,0,0" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Column="1">
      <ContentControl x:Name="PageHost" Focusable="False" />

      <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
              Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="12" Padding="18,12" Visibility="Collapsed" MaxWidth="560">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{StaticResource AuroraBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="ToastText" Margin="12,0,0,0" TextWrapping="Wrap" FontSize="13" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
