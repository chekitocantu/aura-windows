<UserControl x:Class="Aura.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid Margin="40,30,28,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
      <TextBlock x:Name="SubtitleText" Style="{StaticResource Sub}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,22,12,6">
      <WrapPanel x:Name="SourceBar">
        <RadioButton x:Name="SrcMotion" Style="{StaticResource Pill}" GroupName="src" Tag="MotionBgs" Checked="Source_Checked" />
        <RadioButton x:Name="SrcWallhaven" Style="{StaticResource Pill}" GroupName="src" Tag="Wallhaven" Checked="Source_Checked" />
        <RadioButton x:Name="SrcBing" Style="{StaticResource Pill}" GroupName="src" Tag="Bing" Checked="Source_Checked" />
        <RadioButton x:Name="SrcMinimal" Style="{StaticResource Pill}" GroupName="src" Tag="Minimalistic" Checked="Source_Checked" />
      </WrapPanel>

      <DockPanel Margin="0,8,0,0">
        <StackPanel x:Name="WallhavenOptions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <ComboBox x:Name="SortBox" MinWidth="150" Margin="0,0,8,0" SelectionChanged="Option_Changed" />
          <ComboBox x:Name="ResBox" MinWidth="150" SelectionChanged="Option_Changed" />
        </StackPanel>
        <StackPanel x:Name="SearchRow" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,16,0">
          <TextBox x:Name="SearchBox" Width="300" KeyDown="Search_KeyDown" />
          <Button x:Name="SearchButton" Margin="8,0,0,0" Click="Search_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE721;" />
              <TextBlock x:Name="SearchText" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>

      <WrapPanel x:Name="CategoryBar" Margin="0,14,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                  SizeChanged="Scroller_SizeChanged" Margin="0,6,0,0">
      <StackPanel>
        <ItemsControl x:Name="Cards">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="{Binding CardSlot, ElementName=Root}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Card" Margin="0,0,16,16" CornerRadius="14" Background="{StaticResource Card}"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                  <Grid Height="{Binding CardImageHeight, ElementName=Root}">
                    <Border CornerRadius="13,13,0,0" Background="{StaticResource Side}" />
                    <Border CornerRadius="13,13,0,0">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                    <Border Style="{StaticResource Badge}">
                      <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <Border x:Name="Hover" CornerRadius="13,13,0,0" Background="{StaticResource Scrim}" Visibility="Collapsed">
                      <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Click="DownloadApply_Click" Tag="{Binding}" Padding="16,8"
                              Visibility="{Binding IsDownloading, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE768;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding DownloadApplyText}" />
                        </StackPanel>
                      </Button>
                    </Border>
                  </Grid>
                  <StackPanel Margin="14,10,14,12">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,10,0,0" Height="32">
                      <Button HorizontalAlignment="Left" Padding="12,6" Click="Download_Click" Tag="{Binding}"
                              Visibility="{Binding IsIdle, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE896;" />
                          <TextBlock Margin="8,0,0,0" FontSize="12" Text="{Binding DownloadText}" />
                        </StackPanel>
                      </Button>
                      <ProgressBar VerticalAlignment="Center" Maximum="1" Value="{Binding Progress}"
                                   Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}" />
                      <DockPanel Visibility="{Binding IsDone, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Padding="12,6" Click="ApplyLocal_Click" Tag="{Binding}">
                          <TextBlock FontSize="12" Text="{Binding ApplyText}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource Accent2}" />
                          <TextBlock Margin="6,0,0,0" FontSize="12" Text="{Binding DoneText}" Foreground="{StaticResource Accent2}" />
                        </StackPanel>
                      </DockPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}" />
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,24"
                   TextWrapping="Wrap" TextAlignment="Center" />
        <Button x:Name="MoreButton" HorizontalAlignment="Center" Margin="0,0,0,36" Padding="22,10" Click="More_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
