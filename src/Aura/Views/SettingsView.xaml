<UserControl x:Class="Aura.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,30,40,32" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,24" />

      <!-- General -->
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock x:Name="GeneralTitle" Style="{StaticResource H2}" />
          <DockPanel Margin="0,4,0,14">
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" SelectionChanged="Language_Changed" />
            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" Click="Startup_Click" />
          <TextBlock x:Name="StartupHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,70,14" TextWrapping="Wrap" />
          <DockPanel>
            <Button x:Name="FolderButton" DockPanel.Dock="Right" Click="Folder_Click" />
            <StackPanel>
              <TextBlock x:Name="FolderLabel" />
              <TextBlock x:Name="FolderPath" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,16,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Playback -->
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock x:Name="PlaybackTitle" Style="{StaticResource H2}" />
          <DockPanel Margin="0,4,0,14">
            <ComboBox x:Name="FitBox" DockPanel.Dock="Right" SelectionChanged="Fit_Changed" MinWidth="220" />
            <TextBlock x:Name="FitLabel" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Margin="0,0,0,14">
            <ComboBox x:Name="QualityBox" DockPanel.Dock="Right" SelectionChanged="Quality_Changed" MinWidth="220" />
            <TextBlock x:Name="QualityLabel" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox x:Name="MuteBox" Style="{StaticResource Switch}" Click="Mute_Click" />
          <DockPanel x:Name="VolumeRow" Margin="0,12,0,14">
            <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="VolumeLabel" VerticalAlignment="Center" Width="120" />
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" Margin="8,0,16,0" />
          </DockPanel>
          <CheckBox x:Name="HwdecBox" Style="{StaticResource Switch}" Click="Hwdec_Click" />
          <TextBlock x:Name="HwdecHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,70,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Auto pause -->
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock x:Name="PauseTitle" Style="{StaticResource H2}" />
          <CheckBox x:Name="PauseFullscreenBox" Style="{StaticResource Switch}" Click="Pause_Click" Margin="0,4,0,12" />
          <CheckBox x:Name="PauseMaximizedBox" Style="{StaticResource Switch}" Click="Pause_Click" Margin="0,0,0,12" />
          <CheckBox x:Name="PauseBatteryBox" Style="{StaticResource Switch}" Click="Pause_Click" Margin="0,0,0,12" />
          <CheckBox x:Name="PauseLockBox" Style="{StaticResource Switch}" Click="Pause_Click" />
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock x:Name="AboutTitle" Style="{StaticResource H2}" />
          <DockPanel>
            <Button x:Name="LogsButton" DockPanel.Dock="Right" Click="Logs_Click" VerticalAlignment="Center" />
            <TextBlock x:Name="AboutText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
