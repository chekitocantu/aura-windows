<UserControl x:Class="Aura.Views.ScreensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,30,40,32">
      <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
      <TextBlock x:Name="SubtitleText" Style="{StaticResource Sub}" />

      <!-- Monitor map, to scale -->
      <Border Style="{StaticResource Panel}" Margin="0,24,0,20" Padding="24">
        <ItemsControl x:Name="Map" Height="230" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas x:Name="MapCanvas" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}" />
              <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="{Binding W}" Height="{Binding H}">
                <Border CornerRadius="10" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="2" />
                <Border CornerRadius="9" Margin="2">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border Background="{StaticResource Glass}" CornerRadius="16" Width="32" Height="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <ItemsControl x:Name="Rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Panel}" Padding="16">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="160" Height="90" CornerRadius="10" Background="{StaticResource Side}">
                  <Border CornerRadius="10">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Click="Clear_Click" Tag="{Binding}" Margin="0,0,8,0"
                          Visibility="{Binding HasFile, Converter={StaticResource Vis}}" Content="{Binding ClearText}" />
                  <Button Style="{StaticResource PrimaryButton}" Click="Change_Click" Tag="{Binding}" Content="{Binding ChangeText}" />
                </StackPanel>
                <StackPanel Margin="20,0,16,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding FileName}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
