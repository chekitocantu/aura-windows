<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aura</AssemblyName>
    <RootNamespace>Aura</RootNamespace>
    <ApplicationIcon>Assets\aura.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Aura para Windows</Product>
    <Company>Chekito</Company>
    <Copyright>GPL-3.0-or-later</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aura.Core\Aura.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\aura.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
